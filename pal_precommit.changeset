-    assert_eq!(calculate_sentence_progress(0, 0, 5), 0.0);
-    
-    // At word 2: 2/5 = 40%
-    assert_eq!(calculate_sentence_progress(2, 0, 5), 0.4);
-    
-    // At word 4: 4/5 = 80%
-    assert_eq!(calculate_sentence_progress(4, 0, 5), 0.8);
-}
-
